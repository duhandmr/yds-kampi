# ------------------------------------------------------------
# Yaren'in YDS Kampı - ortam değişkenleri örneği
# Bu dosyayı .env olarak kopyalayın ve değerleri kendi ortamınıza göre doldurun.
# GERÇEK PAROLA VEYA ANAHTARLARI ASLA GIT'E EKLEMEYİN.
# ------------------------------------------------------------

# PostgreSQL bağlantısı (Neon, Supabase, Vercel Postgres vb. ile uyumlu)
# Neon cold start: runtime Prisma istemcisi connect_timeout ve pool_timeout değerlerini 30 sn yapar.
# Migration bağlantısında connect_timeout=30 kullanın.
# Havuzlu (pooled) bağlantı adresi:
DATABASE_URL="postgresql://KULLANICI:PAROLA@HOST:5432/yds_kampi?schema=public"
# Migration'lar için Neon'daki doğrudan (pooler olmayan) bağlantı adresi:
DATABASE_URL_UNPOOLED="postgresql://KULLANICI:PAROLA@HOST:5432/yds_kampi?schema=public"

# Uygulamanın herkese açık adresi (oturum çerezi ve yönlendirmeler için)
APP_URL="http://localhost:3000"

# Oturum süresi (gün)
SESSION_TTL_DAYS="14"

# Vercel Cron güvenliği: Vercel bu değeri Authorization başlığında otomatik gönderir.
# En az 32 karakterlik rastgele bir değer üretin: openssl rand -base64 48
CRON_SECRET=""

# ------------------------------------------------------------
# Yapay zekâ (isteğe bağlı). Boş bırakılırsa uygulama yalnızca onaylı soru havuzunu kullanır.
# AI_PROVIDER: none | openai | azure-openai
# ------------------------------------------------------------
AI_PROVIDER="none"
AI_API_KEY=""
# OpenAI uyumlu servisler için temel adres (openai için varsayılan https://api.openai.com/v1)
AI_BASE_URL=""
AI_MODEL=""
# Yalnızca azure-openai için:
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-10-21"
# Üretilen her soruyu ikinci bir "kör çözüm" çağrısıyla doğrula (önerilir)
AI_VERIFY_WITH_SOLVER="true"
AI_TIMEOUT_MS="60000"
